#!/bin/sh
# Husky pre-commit hook to enforce PDCA logging

echo "🔍 [SkillsBuilder PDCA Check] Verifying DEV_LOG.md updates..."

# Get list of files staged for commit
STAGED_FILES=$(git diff --cached --name-only)

# Check if staged files include DEV_LOG.md
if echo "$STAGED_FILES" | grep -q "DEV_LOG.md"; then
  echo "✅ [Pass] DEV_LOG.md is included in this commit. PDCA Act phase satisfied."
  exit 0
else
  echo "❌ [Fail] SOP Violation: DEV_LOG.md has NOT been updated!"
  echo "⚠️  SkillsBuilder requires you to log the RCA and CAPA in DEV_LOG.md before committing."
  echo "👉 Please update DEV_LOG.md, run 'git add DEV_LOG.md', and try committing again."
  exit 1
fi
